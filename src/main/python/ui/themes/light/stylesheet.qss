/*
 * Snooz light theme.
 *
 * Colors are not written here directly: use the names defined in tokens.json
 * (same folder) with an "@" prefix, e.g. "color: @text;". StyleManager replaces
 * each of them by its value when the theme is activated, so a color is changed
 * for the whole application in tokens.json only.
 *
 * Fonts: the Snooz font is set by the application (commons/fonts.py). Do not add
 * font sizes to rules for the widgets of forms (labels, buttons, tables...): a
 * rule has priority over the sizes set in the forms (Font panel of Qt Designer),
 * which Snooz shows since the main window only sets the family of the font.
 * Text styles in code: set_text_style of commons/fonts.py. The sizes of the
 * menus come from the text styles, e.g. "font-size: @font_body;".
 *
 * Small QPushButtons (maximum width below 80px, e.g. ">" or "...") get a compact
 * padding generated by StyleManager, so their text is not clipped, and keep
 * their width.
 *
 * Button variants: setProperty("variant", "primary") on a QPushButton (or a
 * "variant" dynamic property in Qt Designer) gives it the main action style.
 *
 * After editing this file or tokens.json, recompile the resources from
 * src/main/python:
 *    pyside6-rcc ./ui/themes/themes.qrc -o themes_rc.py
 * and copy themes_rc.py to ui/themes/themes_rc.py.
 */


/* ====== MENUS ====== */
/* Menu bar: solid dark blue, like the title bar (MainWindow). */
QMenuBar {
   background-color: @chrome;
   color: @chrome_text;
   font-size: @font_body;
   padding: 4px;
}

QMenuBar::item {
   background-color: transparent;
   color: @chrome_text;
   padding: 5px 12px;
   margin: 0px 1px;
   border-radius: 6px;
}

QMenuBar::item:selected {
   background-color: @chrome_hover;
}

QMenu {
   background-color: @menu_bg;
   color: @menu_text;
   border: 1px solid @menu_border;
   font-size: @font_body;
   padding: 6px;
}

/* Menus of the menu bar, see round_menu_corners in commons/theme_helpers.py. */
QMenu[snoozRounded="true"] {
   border-radius: 10px;
}

QMenu::item {
   padding: 6px 30px 6px 12px;
   border-radius: 6px;
}

QMenu::item:selected {
   background-color: @primary_soft;
   color: @primary_pressed;
}

QMenu::item:disabled {
   color: @text_disabled;
}

QMenu::separator {
   height: 1px;
   margin: 5px 6px;
   background-color: @separator;
}

/* Boxes of the tool versions in the menus (OrderedMenu, MenuEndpointHandler.py) */
OrderedMenu {
   qproperty-versionBackground: @chrome_soft;
   qproperty-versionColor: @chrome;
}

/* Tooltips: round corners thanks to a transparent window (SnoozStyle in
   commons/theme_helpers.py). */
QToolTip {
   color: @text;
   background-color: @surface;
   border: 1px solid @border;
   border-radius: 8px;
   padding: 6px 10px;
}


/* ====== TOOL LEFT PANEL ====== */
QWidget[accessibleName="task_main"] {
    background-color: @primary_soft;
}

 /* QToolBox*/
 /*For some reason this one is necessary to make the next one work...*/
 QToolBox QScrollArea>QWidget>QWidget {
   background-color:	@primary_soft;
   padding:0;
   margin:0;
}

QToolBox QScrollArea {
   padding-top:0px;
   margin-top:0px;
   background-color:	@primary_soft;
   border: 0px solid @border;
   border-top-width: 0px;
   border-left-width: 0px;
   border-right-width: 0px;
   border-bottom-width: 0px;

   border-top-left-radius :0px;
   border-top-right-radius :0px;
   border-bottom-left-radius :10px;
   border-bottom-right-radius :10px;
}

QToolBox::tab {
 	background-color: @primary_soft;
   border-radius: 10px;
   border: 0px solid @border;
}

QToolBox::tab:first {
	font-size: @font_body;
	font-weight:bold;
}

QToolBox::tab:selected {
	background-color: @primary;
	color: @on_primary;
   border-top: none;
   border-top-left-radius :10px;
   border-top-right-radius :10px;
   border-bottom-left-radius :0px;
   border-bottom-right-radius :0px;
   border: 0px;
}

QToolBox::tab:hover {
	background-color: @primary;
	color: @on_primary;
}

/* Links to the sub-steps of a step (StepsWidget) */
QLabel#step_config_link {
   color: @link;
}


/* ====== BUTTONS ====== */
/* Generic buttons first: the named buttons below override them. */
QPushButton {
   color: @text;
   background-color: @surface;
   border: 1px solid @border;
   border-radius: 6px;
   padding: 3px 8px;
}

/* Dialog buttons (OK, Cancel, Yes, No... and the short buttons of the Snooz
   windows below) keep their 80px minimum width.
   No min-width on the other buttons: it would replace the minimum width set
   in Qt Designer and let layouts shrink the button below its text. */
QDialogButtonBox QPushButton,
#BaseNodeView QPushButton#apply_settings_pushbutton,
#BaseNodeView QPushButton#cancel_settings_pushbutton,
#BaseNodeView QPushButton#clear_pushbutton,
#BaseNodeView QPushButton#save_pushbutton,
#LogsDialog QPushButton#clear_pushbutton,
#LogsDialog QPushButton#close_pushbutton,
#SettingsDialog QPushButton#plugins_remove_pushbutton,
#SettingsDialog QPushButton#plugins_apply_pushButton {
   min-width: 62px;
}

QPushButton:hover {
   background-color: @primary_soft;
   border-color: @primary;
}

QPushButton:pressed {
   background-color: @primary_soft_pressed;
   border-color: @primary_pressed;
}

QPushButton:checked {
   background-color: @primary_soft_pressed;
   border-color: @primary;
}

QPushButton:focus {
   border-color: @primary;
}

QPushButton:flat {
   background-color: transparent;
   border-color: transparent;
}

QPushButton:flat:hover {
   background-color: @primary_soft;
}

/* Buttons showing a "?" help cue (see commons/tooltip_help_decorator.py):
   keep their text clear of the cue. */
QPushButton[snoozHasHelpMark="true"] {
   padding-right: 18px;
}

QPushButton[variant="primary"] {
   color: @on_primary;
   background-color: @primary;
   border-color: @primary;
}

QPushButton[variant="primary"]:hover {
   background-color: @primary_hover;
   border-color: @primary_hover;
}

QPushButton[variant="primary"]:pressed {
   background-color: @primary_pressed;
   border-color: @primary_pressed;
}

/* Run button of the tools: the main action, dark blue like the menu bar. It turns
   green under the mouse: the tool is about to run. */
QPushButton[accessibleName="run_pushbutton"] {
   background-color: @chrome;
   border: 0px;
   color: @on_primary;
   border-radius: 25px;
   padding-top:0px;
   padding-bottom:0px;
   qproperty-icon: url(":/themes/light/icons/play.png");
   qproperty-iconSize: 20px 20px;
}

QPushButton[accessibleName="run_pushbutton"]:hover:!pressed {
   background-color: @run_hover;
   color: @on_primary;
}

QPushButton[accessibleName="run_pushbutton"]:pressed {
   background-color: @run_pressed;
}

QPushButton[accessibleName="save_pushbutton"],
QPushButton[accessibleName="next_pushbutton"],
QPushButton[accessibleName="previous_pushbutton"],
QPushButton[accessibleName="feedback_pushbutton"],
QPushButton[accessibleName="documentation_pushbutton"] {
   background-color: @primary_soft;
   border-radius: 10px;
   padding-left:20px;
   padding-right:20px;
   padding-top:5px;
   padding-bottom:5px;
   border: 0px solid @border;
}

QPushButton[accessibleName="save_pushbutton"]:hover:!pressed,
QPushButton[accessibleName="next_pushbutton"]:hover:!pressed,
QPushButton[accessibleName="previous_pushbutton"]:hover:!pressed,
QPushButton[accessibleName="feedback_pushbutton"]:hover:!pressed,
QPushButton[accessibleName="documentation_pushbutton"]:hover:!pressed {
   background-color: @primary;
	color: @on_primary;
}

QPushButton[accessibleName="save_pushbutton"]:pressed,
QPushButton[accessibleName="next_pushbutton"]:pressed,
QPushButton[accessibleName="previous_pushbutton"]:pressed,
QPushButton[accessibleName="feedback_pushbutton"]:pressed,
QPushButton[accessibleName="documentation_pushbutton"]:pressed {
   background-color: @primary_pressed;
	color: @on_primary;
}

/* Save Workspace: secondary action, outlined. */
QPushButton[accessibleName="save_pushbutton"] {
   color: @primary;
   background-color: @surface;
   border: 1px solid @primary;
}

/* Next: the way forward in the steps of a tool. */
QPushButton[accessibleName="next_pushbutton"] {
   color: @on_primary;
   background-color: @primary;
}

QPushButton[accessibleName="next_pushbutton"]:hover:!pressed {
   background-color: @primary_hover;
}

/* Navigation buttons (home, tool, app, process). Their icons are set by
   MainWindow, the checked one is the current page (NavigationManager). */
QPushButton[accessibleName="home_button"],
QPushButton[accessibleName="app_button"],
QPushButton[accessibleName="task_button"],
QPushButton[accessibleName="schema_button"] {
   color: @text_muted;
   background-color: transparent;
   border: 0px;
   border-radius: 10px;
   padding: 7px 14px 7px 10px;
   qproperty-iconSize: 22px 22px;
}

QPushButton[accessibleName="home_button"]:hover:!checked,
QPushButton[accessibleName="app_button"]:hover:!checked,
QPushButton[accessibleName="task_button"]:hover:!checked,
QPushButton[accessibleName="schema_button"]:hover:!checked {
   background-color: @surface_alt;
}

QPushButton[accessibleName="home_button"]:checked,
QPushButton[accessibleName="app_button"]:checked,
QPushButton[accessibleName="task_button"]:checked,
QPushButton[accessibleName="schema_button"]:checked {
   color: @chrome;
   background-color: @chrome_soft;
}

/* Closes the current app, next to the app navigation button. */
QPushButton#close_app_pushButton {
   color: @text_muted;
   background-color: transparent;
   border: 0px;
   border-radius: 16px;
}

QPushButton#close_app_pushButton:hover {
   color: @primary_pressed;
   background-color: @primary_soft;
}

QPushButton[accessibleName="node_option_push_button"] {
   border: 1px solid @border_strong;
   padding:3;
   border-radius: 3px;
   qproperty-icon:url(":/themes/light/icons/settings_icon.png")
}

QPushButton[accessibleName="node_option_push_button"]:hover:!pressed {
   border: 2px solid @primary;
   border-radius: 3px;
}


/* ====== INPUTS ====== */
QLineEdit {
   color: @text;
   background-color: @surface;
   border: 1px solid @border;
   border-radius: 6px;
   padding: 2px 5px;
   selection-background-color: @selection;
   selection-color: @on_selection;
}

QLineEdit:hover {
   border-color: @border_strong;
}

QLineEdit:focus {
   border-color: @primary;
}

QLineEdit:read-only {
   background-color: @surface_alt;
}

/* Frameless text boxes (the descriptions) have no background of their own: they
   blend with the page or the card they are on. */
QPlainTextEdit:enabled, QTextEdit:enabled {
    background-color: transparent;
    color: @text;
    selection-background-color: @selection;
    selection-color: @on_selection;
}

/* Text boxes drawn with a frame (not the frameless descriptions): white fields
   like the line edits. */
QTextEdit[frameShape="StyledPanel"],
QTextEdit[frameShape="Box"],
QTextEdit[frameShape="Panel"],
QPlainTextEdit[frameShape="StyledPanel"],
QPlainTextEdit[frameShape="Box"],
QPlainTextEdit[frameShape="Panel"] {
   background-color: @surface;
   border: 1px solid @border;
   border-radius: 6px;
   padding: 2px;
}

QComboBox {
   color: @text;
   background-color: @surface;
   border: 1px solid @border;
   border-radius: 6px;
   padding: 2px 24px 2px 6px;
   selection-background-color: @selection;
   selection-color: @on_selection;
}

QComboBox:hover {
   border-color: @border_strong;
}

QComboBox:focus,
QComboBox:on {
   border-color: @primary;
}

QComboBox::drop-down {
   subcontrol-origin: padding;
   subcontrol-position: center right;
   width: 20px;
   border: 0px;
}

QComboBox::down-arrow {
   image: url(":/themes/light/icons/chevron_down.png");
   width: 10px;
   height: 10px;
}

QComboBox::down-arrow:disabled {
   image: url(":/themes/light/icons/chevron_down_disabled.png");
}

/* The text field of an editable combo box is drawn by the combo box. */
QComboBox QLineEdit {
   background-color: transparent;
   border: 0px;
   padding: 0px;
}

QComboBox QAbstractItemView,
QComboBox QAbstractItemView[frameShape="StyledPanel"],
QComboBox QListView[frameShape="NoFrame"] {
   color: @text;
   background-color: @surface;
   border: 1px solid @border_strong;
   selection-background-color: @selection;
   selection-color: @on_selection;
   border-radius: 0px;
   padding: 0px;
   outline: 0px;
}

QAbstractSpinBox {
   color: @text;
   background-color: @surface;
   border: 1px solid @border;
   border-radius: 6px;
   padding: 2px 22px 2px 5px;
   selection-background-color: @selection;
   selection-color: @on_selection;
}

QAbstractSpinBox:hover {
   border-color: @border_strong;
}

QAbstractSpinBox:focus {
   border-color: @primary;
}

QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button {
   subcontrol-origin: padding;
   width: 18px;
   border: 0px;
   border-left: 1px solid @border;
   background-color: @surface_alt;
}

QAbstractSpinBox::up-button {
   subcontrol-position: top right;
   border-top-right-radius: 5px;
}

QAbstractSpinBox::down-button {
   subcontrol-position: bottom right;
   border-bottom-right-radius: 5px;
}

QAbstractSpinBox::up-button:hover,
QAbstractSpinBox::down-button:hover {
   background-color: @primary_soft;
}

QAbstractSpinBox::up-button:pressed,
QAbstractSpinBox::down-button:pressed {
   background-color: @primary_soft_pressed;
}

QAbstractSpinBox::up-arrow {
   image: url(":/themes/light/icons/chevron_up.png");
   width: 8px;
   height: 8px;
}

QAbstractSpinBox::down-arrow {
   image: url(":/themes/light/icons/chevron_down.png");
   width: 8px;
   height: 8px;
}

QAbstractSpinBox::up-arrow:disabled,
QAbstractSpinBox::up-arrow:off {
   image: url(":/themes/light/icons/chevron_up_disabled.png");
}

QAbstractSpinBox::down-arrow:disabled,
QAbstractSpinBox::down-arrow:off {
   image: url(":/themes/light/icons/chevron_down_disabled.png");
}

QDateTimeEdit::drop-down {
   subcontrol-origin: padding;
   subcontrol-position: center right;
   width: 20px;
   border: 0px;
}

QDateTimeEdit::down-arrow {
   image: url(":/themes/light/icons/chevron_down.png");
   width: 10px;
   height: 10px;
}

/* ====== CHECK BOXES AND RADIO BUTTONS ====== */
QCheckBox,
QRadioButton {
   spacing: 6px;
}

QCheckBox::indicator,
QRadioButton::indicator,
QGroupBox::indicator,
QAbstractItemView::indicator {
   width: 14px;
   height: 14px;
   border: 1px solid @border_strong;
   background-color: @surface;
}

QCheckBox::indicator,
QGroupBox::indicator,
QAbstractItemView::indicator {
   border-radius: 4px;
}

QRadioButton::indicator {
   border-radius: 8px;
}

QCheckBox::indicator:hover,
QRadioButton::indicator:hover,
QGroupBox::indicator:hover,
QAbstractItemView::indicator:hover {
   border-color: @primary;
}

QCheckBox::indicator:checked,
QGroupBox::indicator:checked,
QAbstractItemView::indicator:checked {
   border-color: @primary;
   background-color: @primary;
   image: url(":/themes/light/icons/check.png");
}

QCheckBox::indicator:indeterminate,
QAbstractItemView::indicator:indeterminate {
   border-color: @primary;
   background-color: @primary;
   image: url(":/themes/light/icons/dash.png");
}

QRadioButton::indicator:checked {
   border-color: @primary;
   background-color: @primary;
   image: url(":/themes/light/icons/radio_dot.png");
}

QCheckBox::indicator:disabled,
QRadioButton::indicator:disabled,
QGroupBox::indicator:disabled,
QAbstractItemView::indicator:disabled {
   border-color: @disabled_border;
   background-color: @disabled_bg;
}

QCheckBox::indicator:checked:disabled,
QCheckBox::indicator:indeterminate:disabled,
QRadioButton::indicator:checked:disabled,
QGroupBox::indicator:checked:disabled,
QAbstractItemView::indicator:checked:disabled {
   border-color: @placeholder_disabled;
   background-color: @placeholder_disabled;
}


QProgressBar {
   color: @text;
   background-color: @surface_alt;
   border: 1px solid @border;
   border-radius: 4px;
   text-align: center;
}

QProgressBar::chunk {
   background-color: @primary;
   border-radius: 3px;
}


/* ====== GROUP BOXES AND TABS ====== */
/* The title is above the frame, like before, so it is never clipped. */
QGroupBox {
   border: 1px solid @border;
   border-radius: 8px;
   margin-top: 1.5em;
   padding-top: 0.2em;
}

QGroupBox::title {
   subcontrol-origin: margin;
   subcontrol-position: top left;
   padding: 0px;
}

QTabWidget::pane {
   background-color: @page;
   border: 1px solid @border;
   border-radius: 8px;
}

/* The tab bar overlaps the top border of the pane by 1px, so the selected tab
   joins its page. Moving the pane up instead would cut its top border when the
   tabs are hidden (main content area, tool steps). */
QTabWidget::tab-bar:top {
   top: 1px;
}

QTabBar::tab:top {
   color: @text_muted;
   background-color: @surface_alt;
   border: 1px solid @border;
   border-bottom: 0px;
   border-top-left-radius: 6px;
   border-top-right-radius: 6px;
   padding: 4px 14px;
   margin-right: 2px;
}

QTabBar::tab:top:!selected {
   border-bottom: 1px solid @border;
}

QTabBar::tab:top:selected {
   color: @text;
   background-color: @surface;
   border-top: 2px solid @primary;
}

QTabBar::tab:top:hover:!selected {
   background-color: @primary_soft;
}


/* ====== ITEM VIEWS (tables, lists, trees) ====== */
QAbstractItemView {
   alternate-background-color: @surface_alt;
   selection-background-color: @selection;
   selection-color: @on_selection;
}

/* Lists, trees and tables: rounded white boxes. The frameless ones too, a bare
   white rectangle stands out on the page (QHeaderView, also a frameless item
   view, is not one of them). The padding keeps the rows inside the corners. */
QAbstractItemView[frameShape="StyledPanel"],
QAbstractItemView[frameShape="Box"],
QAbstractItemView[frameShape="Panel"],
QListView[frameShape="NoFrame"],
QTreeView[frameShape="NoFrame"],
QTableView[frameShape="NoFrame"] {
   background-color: @surface;
   border: 1px solid @border;
   border-radius: 6px;
   padding: 2px;
}

QTableView {
   gridline-color: @grid;
}

/* Headers: white like their view, with a line under them. A filled header
   would show square corners inside the rounded corners of the view. */
QHeaderView::section {
   color: @text_muted;
   background-color: @surface;
   border: 0px;
   border-right: 1px solid @separator;
   border-bottom: 1px solid @border;
   padding: 2px 2px;
}

QTableCornerButton::section {
   background-color: @surface;
   border: 0px;
   border-right: 1px solid @separator;
   border-bottom: 1px solid @border;
}


/* ====== SCROLL AREAS AND SCROLL BARS ====== */
QScrollArea {
    background-color: @page;
}

/* Style the viewport (the actual scrollable content area) */
QScrollArea > QWidget > QWidget {
    background-color: @page;
}

/* Alternative: target the viewport directly */
QScrollArea QWidget#scrollAreaWidgetContents {
    background-color: @page;
}

/* Scroll areas drawn with a frame. */
QScrollArea[frameShape="StyledPanel"],
QScrollArea[frameShape="Box"],
QScrollArea[frameShape="Panel"] {
   border: 1px solid @border;
   border-radius: 8px;
   padding: 2px;
}

QScrollBar:vertical {
   background-color: @scrollbar_track;
   width: 12px;
   margin: 0px;
   border-radius: 6px;
}

QScrollBar::handle:vertical {
   background-color: @scrollbar_handle;
   min-height: 28px;
   border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
   background-color: @scrollbar_handle_hover;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
   height: 0px;
   width: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
   background: transparent;
}

QScrollBar:horizontal {
   background-color: @scrollbar_track;
   height: 12px;
   margin: 0px;
   border-radius: 6px;
}

QScrollBar::handle:horizontal {
   background-color: @scrollbar_handle;
   min-width: 28px;
   border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
   background-color: @scrollbar_handle_hover;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
   height: 0px;
   width: 0px;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
   background: transparent;
}


/* ====== FRAMES, SEPARATORS AND SPLITTERS ====== */
/* Panels (QFrame with a frame) are drawn as rounded cards. ".QFrame" matches
   QFrame itself, not the widgets derived from it (labels, views...). */
.QFrame[frameShape="StyledPanel"],
.QFrame[frameShape="Box"],
.QFrame[frameShape="Panel"] {
   background-color: @surface;
   border: 1px solid @border;
   border-radius: 8px;
   padding: 6px;
}

/* A panel inside a panel is drawn flat: the outer one is the card. */
.QFrame[frameShape="StyledPanel"] .QFrame[frameShape="StyledPanel"],
.QFrame[frameShape="StyledPanel"] .QFrame[frameShape="Box"],
.QFrame[frameShape="StyledPanel"] .QFrame[frameShape="Panel"] {
   background-color: transparent;
   border: 0px;
   padding: 0px;
}

/* Separator lines. */
.QFrame[frameShape="HLine"] {
   border: 0px;
   background-color: @separator;
   min-height: 1px;
   max-height: 1px;
}

.QFrame[frameShape="VLine"] {
   border: 0px;
   background-color: @separator;
   min-width: 1px;
   max-width: 1px;
}

QSplitter::handle {
   background-color: transparent;
}

QSplitter::handle:hover {
   background-color: @primary_soft;
}


/* Pictures of the tools (QLabel showing an image, see frame_pictures in
   commons/theme_helpers.py): white cards, so the white background of a picture
   belongs to its card. Padding + border = _PICTURE_FRAME. */
QLabel[snoozPicture="true"] {
   background-color: @surface;
   border: 1px solid @border;
   border-radius: 10px;
   padding: 6px;
}


/* ====== HOME PAGE (widgets/HomeWidget.py) ====== */
#home_scroll_area,
#home_page {
   background-color: transparent;
}

QPushButton#home_header_button {
   padding: 7px 18px;
   border-radius: 8px;
}

QLabel#home_muted {
   color: @text_muted;
}

/* The analysis workflow: one card with the three steps */
#home_card {
   background-color: @surface;
   border: 1px solid @border;
   border-radius: 14px;
}

#home_card QLabel {
   background-color: transparent;
}

QLabel#home_badge {
   color: @on_primary;
   background-color: @chrome;
   border-radius: 17px;
}

QLabel#home_chip {
   color: @primary_pressed;
   background-color: @primary_soft;
   border-radius: 11px;
   padding: 2px 10px;
}

QLabel#home_arrow {
   color: @border_strong;
}

QPushButton#home_browse_button {
   color: @primary;
   background-color: transparent;
   border: 0px;
   padding: 2px 4px;
}

QPushButton#home_browse_button:hover {
   color: @primary_pressed;
}

QPushButton#home_browse_button:disabled {
   color: @text_disabled;
   background-color: transparent;
   border: 0px;
}

/* Recent files and help links: lists, without boxes */
QLabel#home_link_title,
QLabel#recent_file_label {
   color: @link;
}

QLabel#recent_folder_label {
   color: @text_muted;
}


/* ====== DISABLED STATE STYLES ====== */

/* Disabled QPushButton */
QPushButton:disabled {
    background-color: @disabled_bg;
    border-color: @disabled_border;
    color: @text_disabled;
}

/* Disabled QLineEdit */
QLineEdit:disabled {
    background-color: @disabled_bg;
    border-color: @disabled_border;
    color: @text_disabled;
    padding: 2px 5px;
}

/* Disabled QComboBox */
QComboBox:disabled {
    background-color: @disabled_bg;
    border-color: @disabled_border;
    color: @text_disabled;
}

/* Disabled QLabel */
QLabel:disabled {
    color: @text_disabled;
}

/* Tooltip help cue shown on widgets that expose a toolTip. Its font is set in
   commons/tooltip_help_decorator.py. */
QLabel#snoozTooltipHelpMark {
    color: #b0b0b0;
    background-color: #f7f7f7;
    border: 1px solid #c8c8c8;
    border-radius: 7px;
    padding: 0px;
    min-width: 14px;
    max-width: 14px;
    min-height: 14px;
    max-height: 14px;
}

/* Disabled QCheckBox */
QCheckBox:disabled {
    color: @text_disabled;
}

QToolButton:disabled {
    background-color: @disabled_bg;
    color: @text_disabled;
    padding: 4px;
}

/* Disabled text boxes: grey text. Only the ones with a frame are filled in grey,
   like the other disabled fields: the frameless ones (descriptions) stay flat. */
QTextEdit:disabled,
QPlainTextEdit:disabled {
    background-color: transparent;
    color: @text_disabled;
}

QTextEdit[frameShape="StyledPanel"]:disabled,
QTextEdit[frameShape="Box"]:disabled,
QTextEdit[frameShape="Panel"]:disabled,
QPlainTextEdit[frameShape="StyledPanel"]:disabled,
QPlainTextEdit[frameShape="Box"]:disabled,
QPlainTextEdit[frameShape="Panel"]:disabled {
    background-color: @disabled_bg;
    border-color: @disabled_border;
}

QRadioButton:disabled {
    color: @text_disabled;
}

QAbstractSpinBox:disabled {
    background-color: @disabled_bg;
    border-color: @disabled_border;
    color: @text_disabled;
}

QSlider:disabled {
    background-color: @disabled_bg;
}

QProgressBar:disabled {
    background-color: @disabled_bg;
    color: @text_disabled;
}

QGroupBox:disabled {
    color: @text_disabled;
}

QTabWidget::pane:disabled {
    background-color: @disabled_bg;
}

QTableWidget:disabled,
QTreeWidget:disabled,
QTreeView:disabled,
QTableView:disabled,
QListWidget:disabled,
QListView:disabled {
    background-color: @disabled_bg;
    color: @text_disabled;
}

QScrollBar:disabled {
    background-color: @disabled_bg;
}

QScrollBar:vertical:disabled {
    border: 1px solid @disabled_border;
}

QScrollBar:horizontal:disabled {
    border: 1px solid @disabled_border;
}

QStatusBar:disabled {
    background-color: @disabled_bg;
    color: @text_disabled;
}
